rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admins are users whose profile has isAdmin == true. That flag can only be
    // set from the Firebase console / Admin SDK (see users rule below).
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Fields a user must never be able to grant themselves.
    function touchesPrivilegedUserFields() {
      return request.resource.data.diff(resource == null ? {} : resource.data)
        .affectedKeys().hasAny(['isAdmin', 'verified', 'plan']);
    }

    // ---- User profiles ----
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      // Owners may create/update their profile but not escalate privileges.
      allow create: if isSelf(userId)
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('plan', 'free') == 'free';
      allow update: if (isSelf(userId) && !touchesPrivilegedUserFields()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Listings ----
    // Public read so logged-out visitors can browse; writes are owner/admin only.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.seller.id == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if signedIn()
        && (resource.data.seller.id == request.auth.uid || isAdmin())
        // Sellers cannot approve their own moderation state.
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderationStatus', 'flagReason']));
      allow delete: if isAdmin();
    }

    // ---- Offers: buyer creates, buyer/seller update ----
    match /offers/{offerId} {
      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.sellerId == request.auth.uid || resource.data.buyerId == request.auth.uid);
      allow delete: if false;
    }

    // ---- Escrow: buyer creates, buyer/seller/admin update ----
    match /escrow/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    // ---- Chats: participants only (create checks the incoming doc) ----
    match /chats/{threadId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow delete: if false;
    }

    // ---- Reviews: public read; cannot review yourself; immutable ----
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.get('reviewerId', request.auth.uid) == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---- Alerts: owner only ----
    match /alerts/{alertId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ---- Per-user settings ----
    match /userSettings/{uid} {
      allow read, write: if isSelf(uid);
    }

    // Everything else is denied by default.
  }
}
